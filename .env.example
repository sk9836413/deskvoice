# Option 1: Gemini API key from AI Studio
GEMINI_API_KEY=

# Option 2: Vertex AI / Gemini Enterprise Agent Platform (no key; uses your gcloud login or the Cloud Run service account)
# USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model name (use the latest Flash model available to you)
GEMINI_MODEL=gemini-2.5-flash

# Force the offline rule-based brain even when a key is set
# DESKVOICE_MODE=demo
